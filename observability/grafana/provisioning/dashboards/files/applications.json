{
  "annotations": { "list": [] },
  "description": "Temps de réponse, Requêtes/s, Erreurs, Disponibilité par application",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps", "min": 0 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by(service_name) (rate(http_server_request_count_total[5m]))",
          "legendFormat": "{{ service_name }}",
          "refId": "A"
        }
      ],
      "title": "Requêtes / seconde",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s", "min": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 1 },
            { "color": "red", "value": 2 }
          ]}
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by(service_name, le) (rate(http_server_duration_milliseconds_bucket[5m]))) / 1000",
          "legendFormat": "{{ service_name }} P95",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by(service_name, le) (rate(http_server_duration_milliseconds_bucket[5m]))) / 1000",
          "legendFormat": "{{ service_name }} P50",
          "refId": "B"
        }
      ],
      "title": "Temps de réponse (P50 / P95)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by(service_name) (rate(http_server_request_count_total{http_status_code=~\"5..\"}[5m])) / sum by(service_name) (rate(http_server_request_count_total[5m]))",
          "legendFormat": "{{ service_name }}",
          "refId": "A"
        }
      ],
      "title": "Taux d'erreurs 5xx",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "orange", "value": 0.95 },
            { "color": "green", "value": 0.99 }
          ]}
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg_over_time(up{job=~\"otel-app-metrics|.*app.*\"}[24h])",
          "legendFormat": "{{ instance }}",
          "refId": "A"
        }
      ],
      "title": "Disponibilité (24h)",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["applications", "otel"],
  "time": { "from": "now-3h", "to": "now" },
  "timezone": "Europe/Paris",
  "title": "Applications",
  "uid": "applications",
  "version": 1
}
