{
  "annotations": { "list": [] },
  "description": "Logs centralisés ERROR / WARNING / INFO avec moteur de recherche",
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short", "min": 0 },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by(level) (count_over_time({job!=\"\"} |= `` | json | level != `` [$__interval]))",
          "legendFormat": "{{ level }}",
          "refId": "A"
        }
      ],
      "title": "Volume de logs par niveau",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 6 },
      "id": 2,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=~\".+\"} |= \"$search\" | json | level =~ \"$level\"",
          "legendFormat": "",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Logs",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["logs", "loki"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "", "value": "" },
        "hide": 0,
        "label": "Recherche",
        "name": "search",
        "options": [],
        "query": "",
        "type": "textbox"
      },
      {
        "current": { "selected": false, "text": "ERROR|WARNING|INFO", "value": "ERROR|WARNING|INFO" },
        "hide": 0,
        "includeAll": true,
        "label": "Niveau",
        "multi": true,
        "name": "level",
        "options": [
          { "selected": true, "text": "All", "value": "$__all" },
          { "selected": false, "text": "ERROR", "value": "ERROR" },
          { "selected": false, "text": "WARNING", "value": "WARNING" },
          { "selected": false, "text": "INFO", "value": "INFO" }
        ],
        "query": "ERROR,WARNING,INFO",
        "type": "custom"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "Europe/Paris",
  "title": "Logs",
  "uid": "logs",
  "version": 1
