# Copier ce fichier en .env et remplir les valeurs

# Grafana
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=changeme

# SMTP Office365 (pour les alertes email)
SMTP_USER=alerts@votre-domaine.com
SMTP_PASSWORD=votre-mot-de-passe

# Alertes
ALERT_EMAIL=ops-team@votre-domaine.com

# Microsoft Teams (webhook URL)
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/VOTRE-ID-WEBHOOK
