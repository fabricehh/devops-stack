# Copier en .env et remplir avant de lancer docker compose up

# Grafana
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=changeme

# SMTP Office365 (alertes email)
SMTP_USER=alerts@votre-domaine.com
SMTP_PASSWORD=votre-mot-de-passe

# Microsoft Teams (webhook)
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/VOTRE-ID

# Destinataire des alertes critiques
ALERT_EMAIL=ops-team@votre-domaine.com
